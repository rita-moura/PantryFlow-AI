{
  "name": "pantryflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "An observable, evaluated and resource-conscious meal planning and pantry management platform.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @pantryflow/api --filter @pantryflow/web dev",
    "build": "corepack pnpm --recursive --if-present build",
    "test": "corepack pnpm --recursive --if-present test",
    "test:e2e": "corepack pnpm --filter @pantryflow/api test:e2e",
    "lint": "corepack pnpm --recursive --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "db:generate": "corepack pnpm --filter @pantryflow/api db:generate",
    "db:migrate": "corepack pnpm --filter @pantryflow/api db:migrate",
    "db:seed": "corepack pnpm --filter @pantryflow/api db:seed",
    "db:studio": "corepack pnpm --filter @pantryflow/api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  }
}
