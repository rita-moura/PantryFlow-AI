{
  "name": "@pantryflow/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.35.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.1",
    "typescript-eslint": "^8.42.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^\\.\\./src/index\\.js$": "<rootDir>/src/index.ts",
      "^\\.\\./src/embeddings\\.js$": "<rootDir>/src/embeddings.ts",
      "^\\.\\./src/rag\\.js$": "<rootDir>/src/rag.ts",
      "^\\.\\./src/assistant\\.js$": "<rootDir>/src/assistant.ts",
      "^\\.\\./src/tools\\.js$": "<rootDir>/src/tools.ts",
      "^\\.\\./src/agent\\.js$": "<rootDir>/src/agent.ts",
      "^\\.\\./src/observability\\.js$": "<rootDir>/src/observability.ts",
      "^\\.\\./src/evaluation\\.js$": "<rootDir>/src/evaluation.ts",
      "^\\./embeddings\\.js$": "<rootDir>/src/embeddings.ts",
      "^\\./rag\\.js$": "<rootDir>/src/rag.ts",
      "^\\./assistant\\.js$": "<rootDir>/src/assistant.ts",
      "^\\./tools\\.js$": "<rootDir>/src/tools.ts",
      "^\\./agent\\.js$": "<rootDir>/src/agent.ts",
      "^\\./observability\\.js$": "<rootDir>/src/observability.ts",
      "^\\./evaluation\\.js$": "<rootDir>/src/evaluation.ts"
    },
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.spec.json"
      }
    }
  }
}
